# Базовий URL серверної частини (ЛР01–ЛР03). Vite віддає в код лише змінні з префіксом VITE_,
# тому тут ніколи не зберігаємо секрети — вони потрапляють у фінальний бандл.
VITE_API_URL=http://localhost:3000/api

# Назва застосунку (використовується у Header і <title>)
VITE_APP_NAME=LegalConsult

# Socket.io — адреса сервера БЕЗ /api (префікс належить лише REST-маршрутам)
VITE_SOCKET_URL=http://localhost:3000
